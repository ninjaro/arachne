{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ninjaro/arachne/contracts/artifacts/research_candidate_graph_materialization_v1.schema.json",
  "title": "Research-candidate graph materialization artifact v1",
  "description": "Resolved candidate graph payload referenced by research_candidate_graph_plan_v1.plan_artifact.",
  "type": "object",
  "required": [
    "artifact_type",
    "format_version",
    "plan_id",
    "source_snapshot",
    "algorithm",
    "groups",
    "candidates",
    "works",
    "relations"
  ],
  "properties": {
    "artifact_type": {
      "const": "research_candidate_graph_materialization_v1"
    },
    "format_version": {
      "const": 1
    },
    "plan_id": {
      "$ref": "../schemas/common_v1.schema.json#/$defs/stable_id"
    },
    "source_snapshot": {
      "type": "object",
      "required": [
        "snapshot_id",
        "storage_ref",
        "sha256"
      ],
      "properties": {
        "snapshot_id": {
          "$ref": "../schemas/common_v1.schema.json#/$defs/stable_id"
        },
        "storage_ref": {
          "$ref": "../schemas/common_v1.schema.json#/$defs/non_empty_string"
        },
        "sha256": {
          "$ref": "../schemas/common_v1.schema.json#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "algorithm": {
      "type": "object",
      "required": [
        "name",
        "version",
        "configuration_sha256"
      ],
      "properties": {
        "name": {
          "$ref": "../schemas/common_v1.schema.json#/$defs/non_empty_string"
        },
        "version": {
          "$ref": "../schemas/common_v1.schema.json#/$defs/non_empty_string"
        },
        "configuration_sha256": {
          "$ref": "../schemas/common_v1.schema.json#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/group"
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/candidate"
      }
    },
    "works": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/work"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relation"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "group": {
      "type": "object",
      "required": [
        "group_id",
        "label",
        "order",
        "candidate_count",
        "rationale"
      ],
      "properties": {
        "group_id": {
          "$ref": "../schemas/common_v1.schema.json#/$defs/stable_id"
        },
        "label": {
          "$ref": "../schemas/common_v1.schema.json#/$defs/non_empty_string"
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "candidate_count": {
          "type": "integer",
          "minimum": 0
        },
        "rationale": {
          "$ref": "../schemas/common_v1.schema.json#/$defs/non_empty_string"
        },
        "attributes": {
          "$ref": "#/$defs/attributes"
        }
      },
      "additionalProperties": false
    },
    "candidate": {
      "type": "object",
      "required": [
        "candidate_id",
        "external_id",
        "label",
        "kind",
        "rank",
        "coverage",
        "group_id",
        "selection_reasons",
        "source_snapshot_id"
      ],
      "properties": {
        "candidate_id": {
          "$ref": "../schemas/common_v1.schema.json#/$defs/stable_id"
        },
        "external_id": {
          "$ref": "../schemas/common_v1.schema.json#/$defs/non_empty_string"
        },
        "label": {
          "$ref": "../schemas/common_v1.schema.json#/$defs/non_empty_string"
        },
        "kind": {
          "enum": [
            "candidate",
            "grey"
          ]
        },
        "rank": {
          "type": "integer",
          "minimum": 1
        },
        "coverage": {
          "type": "number",
          "minimum": 0
        },
        "group_id": {
          "$ref": "../schemas/common_v1.schema.json#/$defs/stable_id"
        },
        "selection_reasons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "../schemas/common_v1.schema.json#/$defs/non_empty_string"
          }
        },
        "source_snapshot_id": {
          "$ref": "../schemas/common_v1.schema.json#/$defs/stable_id"
        },
        "attributes": {
          "$ref": "#/$defs/attributes"
        }
      },
      "additionalProperties": false
    },
    "work": {
      "type": "object",
      "required": [
        "work_id",
        "candidate_id",
        "external_id",
        "label",
        "source_snapshot_id"
      ],
      "properties": {
        "work_id": {
          "$ref": "../schemas/common_v1.schema.json#/$defs/stable_id"
        },
        "candidate_id": {
          "$ref": "../schemas/common_v1.schema.json#/$defs/stable_id"
        },
        "external_id": {
          "$ref": "../schemas/common_v1.schema.json#/$defs/non_empty_string"
        },
        "label": {
          "$ref": "../schemas/common_v1.schema.json#/$defs/non_empty_string"
        },
        "year": {
          "type": "integer"
        },
        "source_snapshot_id": {
          "$ref": "../schemas/common_v1.schema.json#/$defs/stable_id"
        },
        "attributes": {
          "$ref": "#/$defs/attributes"
        }
      },
      "additionalProperties": false
    },
    "relation_provenance": {
      "type": "object",
      "required": [
        "origin",
        "source_snapshot_id",
        "algorithm_version",
        "explanation"
      ],
      "properties": {
        "origin": {
          "const": "algorithmic_external"
        },
        "source_snapshot_id": {
          "$ref": "../schemas/common_v1.schema.json#/$defs/stable_id"
        },
        "algorithm_version": {
          "$ref": "../schemas/common_v1.schema.json#/$defs/non_empty_string"
        },
        "explanation": {
          "$ref": "../schemas/common_v1.schema.json#/$defs/non_empty_string"
        }
      },
      "additionalProperties": false
    },
    "relation": {
      "type": "object",
      "required": [
        "relation_id",
        "source_id",
        "target_id",
        "relation_type",
        "provenance"
      ],
      "properties": {
        "relation_id": {
          "$ref": "../schemas/common_v1.schema.json#/$defs/stable_id"
        },
        "source_id": {
          "$ref": "../schemas/common_v1.schema.json#/$defs/stable_id"
        },
        "target_id": {
          "$ref": "../schemas/common_v1.schema.json#/$defs/stable_id"
        },
        "relation_type": {
          "$ref": "../schemas/common_v1.schema.json#/$defs/non_empty_string"
        },
        "weight": {
          "type": "number"
        },
        "provenance": {
          "$ref": "#/$defs/relation_provenance"
        },
        "attributes": {
          "$ref": "#/$defs/attributes"
        }
      },
      "additionalProperties": false
    },
    "attributes": {
      "type": "object",
      "description": "Optional algorithm-owned rank, grey-node, profile, or explanation metadata."
    }
  }
}
