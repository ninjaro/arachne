{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ninjaro/arachne/contracts/artifacts/viewer_projection_data_v1.schema.json",
  "title": "Resolved static viewer projection data v1",
  "description": "UI data referenced by viewer_projection_v1.projection with explicit origin and snapshot provenance on every node and edge.",
  "type": "object",
  "required": [
    "artifact_type",
    "format_version",
    "projection_id",
    "projection_version",
    "product_snapshot_id",
    "nodes",
    "edges"
  ],
  "properties": {
    "artifact_type": {
      "const": "viewer_projection_data_v1"
    },
    "format_version": {
      "const": 1
    },
    "projection_id": {
      "$ref": "../schemas/common_v1.schema.json#/$defs/stable_id"
    },
    "projection_version": {
      "$ref": "../schemas/common_v1.schema.json#/$defs/non_empty_string"
    },
    "product_snapshot_id": {
      "$ref": "../schemas/common_v1.schema.json#/$defs/stable_id"
    },
    "candidate_snapshot_id": {
      "$ref": "../schemas/common_v1.schema.json#/$defs/stable_id"
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "node_provenance": {
      "type": "object",
      "required": [
        "origin",
        "snapshot_id"
      ],
      "properties": {
        "origin": {
          "enum": [
            "human_authored",
            "derived_external",
            "derived_projection"
          ]
        },
        "snapshot_id": {
          "$ref": "../schemas/common_v1.schema.json#/$defs/stable_id"
        },
        "source_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "../schemas/common_v1.schema.json#/$defs/stable_id"
          }
        },
        "algorithm_version": {
          "$ref": "../schemas/common_v1.schema.json#/$defs/non_empty_string"
        },
        "explanation": {
          "$ref": "../schemas/common_v1.schema.json#/$defs/non_empty_string"
        }
      },
      "additionalProperties": false
    },
    "edge_provenance": {
      "type": "object",
      "required": [
        "origin",
        "snapshot_id",
        "explanation"
      ],
      "properties": {
        "origin": {
          "enum": [
            "human_authored",
            "derived_external",
            "derived_projection"
          ]
        },
        "snapshot_id": {
          "$ref": "../schemas/common_v1.schema.json#/$defs/stable_id"
        },
        "source_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "../schemas/common_v1.schema.json#/$defs/stable_id"
          }
        },
        "algorithm_version": {
          "$ref": "../schemas/common_v1.schema.json#/$defs/non_empty_string"
        },
        "explanation": {
          "$ref": "../schemas/common_v1.schema.json#/$defs/non_empty_string"
        }
      },
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "required": [
        "node_id",
        "node_type",
        "label",
        "graph_domain",
        "provenance"
      ],
      "properties": {
        "node_id": {
          "$ref": "../schemas/common_v1.schema.json#/$defs/stable_id"
        },
        "node_type": {
          "$ref": "../schemas/common_v1.schema.json#/$defs/non_empty_string"
        },
        "label": {
          "$ref": "../schemas/common_v1.schema.json#/$defs/non_empty_string"
        },
        "graph_domain": {
          "enum": [
            "product",
            "candidate"
          ]
        },
        "provenance": {
          "$ref": "#/$defs/node_provenance"
        },
        "attributes": {
          "$ref": "#/$defs/attributes"
        }
      },
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "required": [
        "edge_id",
        "source",
        "target",
        "edge_type",
        "provenance"
      ],
      "properties": {
        "edge_id": {
          "$ref": "../schemas/common_v1.schema.json#/$defs/stable_id"
        },
        "source": {
          "$ref": "../schemas/common_v1.schema.json#/$defs/stable_id"
        },
        "target": {
          "$ref": "../schemas/common_v1.schema.json#/$defs/stable_id"
        },
        "edge_type": {
          "$ref": "../schemas/common_v1.schema.json#/$defs/non_empty_string"
        },
        "provenance": {
          "$ref": "#/$defs/edge_provenance"
        },
        "attributes": {
          "$ref": "#/$defs/attributes"
        }
      },
      "additionalProperties": false
    },
    "attributes": {
      "type": "object",
      "description": "Optional projection-owned medium, year, evidence, soft-guidance, or UI-style metadata."
    }
  }
}
