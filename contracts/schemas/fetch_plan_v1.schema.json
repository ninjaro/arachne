{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ninjaro/arachne/contracts/schemas/fetch_plan_v1.schema.json",
  "title": "Declarative external-data fetch plan v1",
  "type": "object",
  "required": [
    "contract",
    "format_version",
    "plan_id",
    "source",
    "requests",
    "created_at"
  ],
  "properties": {
    "contract": {
      "const": "fetch_plan_v1"
    },
    "format_version": {
      "const": 1
    },
    "plan_id": {
      "$ref": "common_v1.schema.json#/$defs/stable_id"
    },
    "source": {
      "$ref": "common_v1.schema.json#/$defs/non_empty_string"
    },
    "requests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "request_id",
          "locator",
          "purpose"
        ],
        "properties": {
          "request_id": {
            "$ref": "common_v1.schema.json#/$defs/stable_id"
          },
          "locator": {
            "$ref": "common_v1.schema.json#/$defs/non_empty_string"
          },
          "purpose": {
            "$ref": "common_v1.schema.json#/$defs/non_empty_string"
          },
          "entities": {
            "type": "array",
            "items": {
              "$ref": "common_v1.schema.json#/$defs/non_empty_string"
            }
          },
          "fields": {
            "type": "array",
            "items": {
              "$ref": "common_v1.schema.json#/$defs/non_empty_string"
            }
          },
          "languages": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
            }
          },
          "language_fallback": {
            "type": "boolean"
          },
          "identity_query": {
            "$ref": "#/$defs/identity_query"
          },
          "media_files": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {
              "$ref": "#/$defs/media_file"
            }
          },
          "pages": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "archives": {
            "type": "array",
            "items": {
              "$ref": "common_v1.schema.json#/$defs/non_empty_string"
            }
          },
          "follow_up": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "extensions": {
      "$ref": "common_v1.schema.json#/$defs/extensions"
    }
  },
  "$defs": {
    "identity_query": {
      "type": "object",
      "required": [
        "query_id",
        "canonical_entity_ids",
        "kind",
        "value"
      ],
      "properties": {
        "query_id": {
          "$ref": "common_v1.schema.json#/$defs/stable_id"
        },
        "canonical_entity_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(agent|work|concept|manifestation)-[0-9]{6,}$"
          }
        },
        "kind": {
          "type": "string",
          "enum": [
            "name",
            "external_id"
          ]
        },
        "value": {
          "$ref": "common_v1.schema.json#/$defs/non_empty_string"
        },
        "language": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "scheme": {
          "$ref": "common_v1.schema.json#/$defs/non_empty_string"
        },
        "provider_property": {
          "type": "string",
          "pattern": "^P[1-9][0-9]*$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "name"
              }
            }
          },
          "then": {
            "required": [
              "language"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "external_id"
              }
            }
          },
          "then": {
            "required": [
              "scheme",
              "provider_property"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "media_file": {
      "type": "object",
      "required": [
        "remote_key",
        "contexts"
      ],
      "properties": {
        "remote_key": {
          "type": "string",
          "pattern": "^File:.+"
        },
        "contexts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "canonical_entity_id",
              "wikidata_qid",
              "provider_property",
              "media_kind"
            ],
            "properties": {
              "canonical_entity_id": {
                "type": "string",
                "pattern": "^(agent|work|concept|manifestation)-[0-9]{6,}$"
              },
              "wikidata_qid": {
                "type": "string",
                "pattern": "^Q[1-9][0-9]*$"
              },
              "provider_property": {
                "type": "string",
                "enum": [
                  "P18",
                  "P154",
                  "P3383"
                ]
              },
              "media_kind": {
                "type": "string",
                "enum": [
                  "portrait",
                  "poster",
                  "logo",
                  "image"
                ]
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
