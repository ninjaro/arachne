{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ninjaro/arachne/contracts/schemas/arachne_batch.schema.json",
  "title": "Arachne human research batch",
  "description": "Closed human-owned taxonomy, assertion, and evidence writes. Provider-driven general information is outside this contract.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "batch_id", "create", "update", "merge"],
  "properties": {
    "format": {"const": "arachne_batch"},
    "batch_id": {"$ref": "#/$defs/stable_id"},
    "create": {"$ref": "#/$defs/create_operations"},
    "update": {"$ref": "#/$defs/update_operations"},
    "merge": {"$ref": "#/$defs/merge_operations"}
  },
  "$defs": {
    "non_empty_string": {"type": "string", "minLength": 1},
    "stable_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "local_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!(?:agent|work|concept|manifestation)-[0-9]{6,}$)[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "agent_id": {"type": "string", "pattern": "^agent-[0-9]{6,}$"},
    "work_id": {"type": "string", "pattern": "^work-[0-9]{6,}$"},
    "concept_id": {"type": "string", "pattern": "^concept-[0-9]{6,}$"},
    "manifestation_id": {
      "type": "string",
      "pattern": "^manifestation-[0-9]{6,}$"
    },
    "entity_id": {
      "oneOf": [
        {"$ref": "#/$defs/agent_id"},
        {"$ref": "#/$defs/work_id"},
        {"$ref": "#/$defs/concept_id"},
        {"$ref": "#/$defs/manifestation_id"}
      ]
    },
    "concept_reference": {
      "oneOf": [
        {"$ref": "#/$defs/concept_id"},
        {"$ref": "#/$defs/local_id"}
      ]
    },
    "database_or_local_reference": {
      "oneOf": [
        {"type": "integer", "minimum": 1},
        {"$ref": "#/$defs/local_id"}
      ]
    },
    "year": {"type": "integer", "minimum": -9999, "maximum": 9999},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "name_type": {
      "type": "string",
      "enum": [
        "original", "english", "transliteration", "translation", "alias",
        "credited"
      ]
    },
    "concept_type": {
      "type": "string",
      "enum": [
        "genre", "style", "theme", "keyword", "motif", "trope", "phobia",
        "taboo", "technique", "movement", "setting", "mood",
        "content_warning"
      ]
    },
    "concept_slug": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "book", "article", "catalogue", "web_page", "interview", "database",
        "video", "audio", "PDF"
      ]
    },
    "evidence_stance": {
      "type": "string",
      "enum": ["supports", "contradicts", "contextualizes"]
    },
    "work_concept_relation_type": {
      "type": "string",
      "enum": [
        "exemplifies", "contains", "anticipates", "influenced_by",
        "influences", "revives", "parodies", "deconstructs", "associated_with"
      ]
    },
    "reviewed_centrality_scale": {
      "type": "string",
      "enum": ["binary", "ordinal", "graded"]
    },
    "historical_role": {
      "type": "string",
      "enum": [
        "formative", "canonical", "transitional", "hybrid", "revival",
        "late_derivative", "peripheral", "precursor"
      ]
    },
    "concept_relation_type": {
      "type": "string",
      "enum": [
        "broader_than", "narrower_than", "derived_from", "precursor_of",
        "hybrid_of", "revival_of", "regional_variant_of", "influenced_by",
        "opposes", "alias_of"
      ]
    },
    "parent_guide_category": {
      "type": "string",
      "enum": [
        "violence", "sex_nudity", "language", "drugs", "frightening",
        "self_harm", "discrimination", "abuse", "taboo"
      ]
    },
    "spoiler_level": {
      "type": "string",
      "enum": ["none", "mild", "major"]
    },
    "evidence_reference_list": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/database_or_local_reference"}
    },
    "create_operations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "concepts": {"type": "array", "items": {"$ref": "#/$defs/create_concept"}},
        "names": {"type": "array", "items": {"$ref": "#/$defs/create_concept_name"}},
        "sources": {"type": "array", "items": {"$ref": "#/$defs/create_source"}},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/create_evidence"}},
        "work_concepts": {"type": "array", "items": {"$ref": "#/$defs/create_work_concept"}},
        "concept_relations": {"type": "array", "items": {"$ref": "#/$defs/create_concept_relation"}},
        "parent_guide_assertions": {
          "type": "array",
          "items": {"$ref": "#/$defs/create_parent_guide_assertion"}
        }
      }
    },
    "create_concept": {
      "type": "object",
      "additionalProperties": false,
      "required": ["local_id", "concept_type", "slug"],
      "properties": {
        "local_id": {"$ref": "#/$defs/local_id"},
        "concept_type": {"$ref": "#/$defs/concept_type"},
        "slug": {"$ref": "#/$defs/concept_slug"}
      }
    },
    "create_concept_name": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_id", "name_type", "value", "is_preferred"],
      "properties": {
        "entity_id": {"$ref": "#/$defs/concept_reference"},
        "name_type": {"$ref": "#/$defs/name_type"},
        "language_code": {"$ref": "#/$defs/non_empty_string"},
        "script_code": {"$ref": "#/$defs/non_empty_string"},
        "value": {"$ref": "#/$defs/non_empty_string"},
        "is_preferred": {"type": "boolean"}
      }
    },
    "create_source": {
      "type": "object",
      "additionalProperties": false,
      "description": "Human evidence source. Automatically mined provider namespaces are rejected.",
      "required": ["local_id", "source_type"],
      "properties": {
        "local_id": {"$ref": "#/$defs/local_id"},
        "source_type": {"$ref": "#/$defs/source_type"},
        "title": {"$ref": "#/$defs/non_empty_string"},
        "bibliography_text": {"$ref": "#/$defs/non_empty_string"},
        "author_text": {"$ref": "#/$defs/non_empty_string"},
        "publisher": {"$ref": "#/$defs/non_empty_string"},
        "publication_date": {"$ref": "#/$defs/non_empty_string"},
        "url": {"$ref": "#/$defs/non_empty_string"},
        "doi": {"$ref": "#/$defs/non_empty_string"},
        "isbn": {"$ref": "#/$defs/non_empty_string"},
        "language_code": {"$ref": "#/$defs/non_empty_string"}
      },
      "anyOf": [
        {"required": ["url"]},
        {"required": ["doi"]},
        {"required": ["isbn"]},
        {"required": ["bibliography_text"]}
      ]
    },
    "create_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["local_id", "source_id", "exact_quote", "stance"],
      "properties": {
        "local_id": {"$ref": "#/$defs/local_id"},
        "source_id": {"$ref": "#/$defs/database_or_local_reference"},
        "exact_quote": {"$ref": "#/$defs/non_empty_string"},
        "quote_language": {"$ref": "#/$defs/non_empty_string"},
        "quote_translation": {"$ref": "#/$defs/non_empty_string"},
        "locator_json": {"$ref": "#/$defs/non_empty_string"},
        "stance": {"$ref": "#/$defs/evidence_stance"}
      }
    },
    "create_work_concept": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "local_id", "work_id", "concept_id", "relation_type", "centrality",
        "centrality_scale", "evidence"
      ],
      "properties": {
        "local_id": {"$ref": "#/$defs/local_id"},
        "work_id": {"$ref": "#/$defs/work_id"},
        "concept_id": {"$ref": "#/$defs/concept_reference"},
        "relation_type": {"$ref": "#/$defs/work_concept_relation_type"},
        "centrality": {"type": "integer", "minimum": 1, "maximum": 100},
        "centrality_scale": {"$ref": "#/$defs/reviewed_centrality_scale"},
        "historical_role": {"$ref": "#/$defs/historical_role"},
        "confidence": {"$ref": "#/$defs/confidence"},
        "evidence": {"$ref": "#/$defs/evidence_reference_list"}
      }
    },
    "create_concept_relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "local_id", "subject_concept_id", "relation_type", "object_concept_id",
        "evidence"
      ],
      "properties": {
        "local_id": {"$ref": "#/$defs/local_id"},
        "subject_concept_id": {"$ref": "#/$defs/concept_reference"},
        "relation_type": {"$ref": "#/$defs/concept_relation_type"},
        "object_concept_id": {"$ref": "#/$defs/concept_reference"},
        "strength": {"type": "integer", "minimum": 1, "maximum": 100},
        "from_year": {"$ref": "#/$defs/year"},
        "to_year": {"$ref": "#/$defs/year"},
        "region_code": {"$ref": "#/$defs/non_empty_string"},
        "confidence": {"$ref": "#/$defs/confidence"},
        "evidence": {"$ref": "#/$defs/evidence_reference_list"}
      }
    },
    "create_parent_guide_assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "local_id", "work_id", "concept_id", "category", "intensity",
        "explicitness", "frequency", "centrality", "realism", "spoiler_level",
        "evidence"
      ],
      "properties": {
        "local_id": {"$ref": "#/$defs/local_id"},
        "work_id": {"$ref": "#/$defs/work_id"},
        "concept_id": {"$ref": "#/$defs/concept_reference"},
        "category": {"$ref": "#/$defs/parent_guide_category"},
        "intensity": {"type": "integer", "minimum": 1, "maximum": 5},
        "explicitness": {"type": "integer", "minimum": 1, "maximum": 5},
        "frequency": {"type": "integer", "minimum": 1, "maximum": 5},
        "centrality": {"type": "integer", "minimum": 1, "maximum": 5},
        "realism": {"type": "integer", "minimum": 1, "maximum": 5},
        "spoiler_level": {"$ref": "#/$defs/spoiler_level"},
        "confidence": {"$ref": "#/$defs/confidence"},
        "evidence": {"$ref": "#/$defs/evidence_reference_list"}
      }
    },
    "update_operations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "concepts": {"type": "array", "items": {"$ref": "#/$defs/update_concept"}},
        "sources": {"type": "array", "items": {"$ref": "#/$defs/update_source"}},
        "work_concepts": {"type": "array", "items": {"$ref": "#/$defs/update_work_concept"}},
        "provider_ids": {
          "type": "array",
          "items": {"$ref": "#/$defs/provider_id_correction"}
        },
        "delete": {"$ref": "#/$defs/delete_operations"}
      }
    },
    "update_concept": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "set", "unset"],
      "properties": {
        "id": {"$ref": "#/$defs/concept_id"},
        "set": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "concept_type": {"$ref": "#/$defs/concept_type"},
            "slug": {"$ref": "#/$defs/concept_slug"}
          }
        },
        "unset": {"type": "array", "maxItems": 0}
      }
    },
    "source_update_set": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_type": {"$ref": "#/$defs/source_type"},
        "title": {"$ref": "#/$defs/non_empty_string"},
        "bibliography_text": {"$ref": "#/$defs/non_empty_string"},
        "author_text": {"$ref": "#/$defs/non_empty_string"},
        "publisher": {"$ref": "#/$defs/non_empty_string"},
        "publication_date": {"$ref": "#/$defs/non_empty_string"},
        "url": {"$ref": "#/$defs/non_empty_string"},
        "doi": {"$ref": "#/$defs/non_empty_string"},
        "isbn": {"$ref": "#/$defs/non_empty_string"},
        "language_code": {"$ref": "#/$defs/non_empty_string"}
      }
    },
    "source_unset_field": {
      "type": "string",
      "enum": [
        "title", "bibliography_text", "author_text", "publisher",
        "publication_date", "url", "doi", "isbn", "language_code"
      ]
    },
    "update_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "set", "unset"],
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "set": {"$ref": "#/$defs/source_update_set"},
        "unset": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/source_unset_field"}
        }
      },
      "anyOf": [
        {"properties": {"set": {"minProperties": 1}}},
        {"properties": {"unset": {"minItems": 1}}}
      ]
    },
    "work_concept_update_set": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "centrality": {"type": "integer", "minimum": 1, "maximum": 100},
        "centrality_scale": {"$ref": "#/$defs/reviewed_centrality_scale"},
        "historical_role": {"$ref": "#/$defs/historical_role"},
        "confidence": {"$ref": "#/$defs/confidence"}
      }
    },
    "update_work_concept": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "set", "unset"],
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "set": {"$ref": "#/$defs/work_concept_update_set"},
        "unset": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "enum": ["historical_role", "confidence"]}
        }
      },
      "anyOf": [
        {"properties": {"set": {"minProperties": 1}}},
        {"properties": {"unset": {"minItems": 1}}}
      ]
    },
    "provider_id_correction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_id", "provider", "old_external_id", "new_external_id"],
      "properties": {
        "entity_id": {"$ref": "#/$defs/entity_id"},
        "provider": {"$ref": "#/$defs/non_empty_string"},
        "old_external_id": {"$ref": "#/$defs/non_empty_string"},
        "new_external_id": {"$ref": "#/$defs/non_empty_string"}
      }
    },
    "positive_id_array": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1}
    },
    "delete_operations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "evidence": {"$ref": "#/$defs/positive_id_array"},
        "work_concepts": {"$ref": "#/$defs/positive_id_array"},
        "concept_relations": {"$ref": "#/$defs/positive_id_array"},
        "parent_guide_assertions": {"$ref": "#/$defs/positive_id_array"}
      }
    },
    "merge_operations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "concepts": {"type": "array", "items": {"$ref": "#/$defs/merge_concepts"}}
      }
    },
    "merge_concepts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "members", "set", "unset"],
      "properties": {
        "target": {"$ref": "#/$defs/concept_id"},
        "members": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/concept_id"}
        },
        "set": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "concept_type": {"$ref": "#/$defs/concept_type"},
            "slug": {"$ref": "#/$defs/concept_slug"}
          }
        },
        "unset": {"type": "array", "maxItems": 0}
      }
    }
  }
}
