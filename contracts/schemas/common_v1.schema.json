{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ninjaro/arachne/contracts/schemas/common_v1.schema.json",
  "title": "Arachne contract common definitions v1",
  "$defs": {
    "stable_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9][a-z0-9_-]*)+$"
      }
    },
    "artifact": {
      "type": "object",
      "required": [
        "storage_ref",
        "sha256",
        "byte_length"
      ],
      "properties": {
        "storage_ref": {
          "$ref": "#/$defs/non_empty_string"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 0
        },
        "media_type": {
          "$ref": "#/$defs/non_empty_string"
        }
      },
      "additionalProperties": false
    },
    "export": {
      "type": "object",
      "required": [
        "kind",
        "artifact"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/non_empty_string"
        },
        "artifact": {
          "$ref": "#/$defs/artifact"
        }
      },
      "additionalProperties": false
    },
    "structural_validation": {
      "type": "object",
      "required": [
        "passed",
        "report"
      ],
      "properties": {
        "passed": {
          "const": true
        },
        "report": {
          "$ref": "#/$defs/artifact"
        }
      },
      "additionalProperties": false
    }
  }
}
