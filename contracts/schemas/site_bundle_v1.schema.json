{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ninjaro/arachne/contracts/schemas/site_bundle_v1.schema.json",
  "title": "Deployable static viewer bundle v1",
  "type": "object",
  "required": [
    "contract",
    "format_version",
    "bundle_id",
    "projection_id",
    "product_snapshot_id",
    "viewer_version",
    "entrypoint",
    "bundle",
    "generated_at"
  ],
  "properties": {
    "contract": {
      "const": "site_bundle_v1"
    },
    "format_version": {
      "const": 1
    },
    "bundle_id": {
      "$ref": "common_v1.schema.json#/$defs/stable_id"
    },
    "projection_id": {
      "$ref": "common_v1.schema.json#/$defs/stable_id"
    },
    "product_snapshot_id": {
      "$ref": "common_v1.schema.json#/$defs/stable_id"
    },
    "candidate_snapshot_id": {
      "$ref": "common_v1.schema.json#/$defs/stable_id"
    },
    "viewer_version": {
      "$ref": "common_v1.schema.json#/$defs/non_empty_string"
    },
    "entrypoint": {
      "$ref": "common_v1.schema.json#/$defs/non_empty_string"
    },
    "bundle": {
      "$ref": "common_v1.schema.json#/$defs/artifact"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "extensions": {
      "$ref": "common_v1.schema.json#/$defs/extensions"
    }
  },
  "additionalProperties": false
}
