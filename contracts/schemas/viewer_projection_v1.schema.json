{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ninjaro/arachne/contracts/schemas/viewer_projection_v1.schema.json",
  "title": "UI-oriented static viewer projection v1",
  "type": "object",
  "required": [
    "contract",
    "format_version",
    "projection_id",
    "product_snapshot_id",
    "projection_version",
    "settings_sha256",
    "projection",
    "edge_semantics",
    "generated_at"
  ],
  "properties": {
    "contract": {
      "const": "viewer_projection_v1"
    },
    "format_version": {
      "const": 1
    },
    "projection_id": {
      "$ref": "common_v1.schema.json#/$defs/stable_id"
    },
    "product_snapshot_id": {
      "$ref": "common_v1.schema.json#/$defs/stable_id"
    },
    "candidate_snapshot_id": {
      "$ref": "common_v1.schema.json#/$defs/stable_id"
    },
    "projection_version": {
      "$ref": "common_v1.schema.json#/$defs/non_empty_string"
    },
    "settings_sha256": {
      "$ref": "common_v1.schema.json#/$defs/sha256"
    },
    "projection": {
      "$ref": "common_v1.schema.json#/$defs/artifact"
    },
    "edge_semantics": {
      "type": "object",
      "required": [
        "human_type",
        "derived_types"
      ],
      "properties": {
        "human_type": {
          "$ref": "common_v1.schema.json#/$defs/non_empty_string"
        },
        "derived_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "common_v1.schema.json#/$defs/non_empty_string"
          }
        }
      },
      "additionalProperties": false
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "extensions": {
      "$ref": "common_v1.schema.json#/$defs/extensions"
    }
  },
  "additionalProperties": false
}
