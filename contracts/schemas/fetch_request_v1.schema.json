{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ninjaro/arachne/contracts/schemas/fetch_request_v1.schema.json",
  "title": "Concrete transport request v1",
  "type": "object",
  "required": [
    "contract",
    "format_version",
    "request_id",
    "locator",
    "method",
    "output_ref"
  ],
  "properties": {
    "contract": {
      "const": "fetch_request_v1"
    },
    "format_version": {
      "const": 1
    },
    "request_id": {
      "$ref": "common_v1.schema.json#/$defs/stable_id"
    },
    "door_id": {
      "$ref": "common_v1.schema.json#/$defs/stable_id"
    },
    "endpoint_id": {
      "$ref": "common_v1.schema.json#/$defs/stable_id"
    },
    "operation": {
      "enum": [
        "bulk_snapshot",
        "incremental_harvest",
        "point_lookup",
        "resume_download",
        "backend_read",
        "external_write"
      ]
    },
    "freshness_policy": {
      "enum": [
        "fresh_required",
        "cache_allowed",
        "stale_allowed",
        "offline_only"
      ]
    },
    "idempotency_key": {
      "$ref": "common_v1.schema.json#/$defs/non_empty_string"
    },
    "plan_id": {
      "$ref": "common_v1.schema.json#/$defs/stable_id"
    },
    "locator": {
      "type": "string",
      "format": "uri"
    },
    "method": {
      "enum": [
        "GET",
        "POST"
      ]
    },
    "headers": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "pagination": {
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "none",
            "link_header",
            "cursor",
            "page_number"
          ]
        }
      },
      "additionalProperties": false
    },
    "retry": {
      "type": "object",
      "properties": {
        "maximum_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "initial_delay_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        },
        "maximum_delay_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600000
        },
        "total_delay_budget_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600000
        },
        "respect_retry_after": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "expected": {
      "type": "object",
      "properties": {
        "maximum_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1099511627776
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400000
        },
        "connect_timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400000
        },
        "read_timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400000
        },
        "write_timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400000
        },
        "sha256": {
          "$ref": "common_v1.schema.json#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "redirect_policy": {
      "type": "object",
      "required": [
        "follow",
        "maximum_redirects",
        "allow_https_to_http",
        "allowed_hosts"
      ],
      "properties": {
        "follow": {
          "type": "boolean"
        },
        "maximum_redirects": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "allow_https_to_http": {
          "type": "boolean"
        },
        "allowed_hosts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253,
            "pattern": "^[A-Za-z0-9.-]+(:[0-9]{1,5})?$"
          }
        }
      },
      "additionalProperties": false
    },
    "output_ref": {
      "$ref": "common_v1.schema.json#/$defs/non_empty_string"
    },
    "body_artifact": {
      "$ref": "common_v1.schema.json#/$defs/artifact"
    },
    "resume_artifact": {
      "$ref": "common_v1.schema.json#/$defs/artifact"
    },
    "extensions": {
      "$ref": "common_v1.schema.json#/$defs/extensions"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "resume_download"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "required": [
          "resume_artifact"
        ]
      },
      "else": {
        "not": {
          "required": [
            "resume_artifact"
          ]
        }
      }
    }
  ],
  "additionalProperties": false
}
